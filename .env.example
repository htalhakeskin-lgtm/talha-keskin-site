# Copy to .env.local and fill in. Never commit real values (11-guvenlik §10).
# Validated at start-up by src/lib/public-env.ts and src/lib/env.ts.
# No database, auth or e-mail: content comes from content/*.ts (PLAN.md K-04, ADR-0001).

# ── Site ─────────────────────────────────────────────────────────────
# The ONE canonical public address, no trailing slash (PLAN.md §5.5, K-11).
# canonical, hreflang, sitemap, Open Graph, JSON-LD and the CV PDF links all read it.
# Today: https://<ad-soyad>.vercel.app · later: https://<alan-adi>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Every origin the portfolio is served from, space separated (PLAN.md §5.5, P-06).
# `pnpm embed:check` verifies that each project's frame-ancestors allows all of them.
# Each project repository gets the same variable (docs/onizleme-izinleri.md).
PORTFOLIO_ORIGINS=https://<ad-soyad>.vercel.app

# ── Indexing ─────────────────────────────────────────────────────────
# Set automatically by Vercel: "production" | "preview" | "development".
# Only production is indexed; previews and local builds are noindex and show /stil.
# VERCEL_ENV=
